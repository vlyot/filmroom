    "Narrative": {
      "additionalProperties": false,
      "description": "`template` holds {fact.id} slots and `facts` holds their values for this style and language; the\nclient fills the slots from `facts` alone, so no number in a narrative ever comes from the LLM.\nStatus: `template` (no generation planned), `pending` (template shown, generation queued), `verified`\n(LLM text that passed the verifier) or `failed` (template shown, generation gave up).",
      "properties": {
        "possession_id": {
          "type": "string"
        },
        "style_id": {
          "type": "string"
        },
        "audience": {
          "enum": [
            "coach",
            "player",
            "fan"
          ],
          "type": "string"
        },
        "language": {
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "facts": {
          "additionalProperties": {
            "$ref": "#/$defs/Fact"
          },
          "type": "object"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "template",
            "pending",
            "verified",
            "failed"
          ],
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "possession_id",
        "style_id",
        "audience",
        "language",
        "template",
        "facts",
        "claims",
        "status"
      ],
      "title": "Narrative",
      "type": "object"
    },
    "NarrativeReady": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "narrative",
          "default": "narrative",
          "type": "string"
        },

{
  "x-contract-version": "0.6.0",
  "$defs": {
    "AnalystReply": {
      "additionalProperties": false,
      "description": "The analyst writes no numbers: it cites possessions, and the UI shows their numbers from the engine.\nStatus: `verified`, `fallback` (a canned line with the moments found, after the verifier rejected the\nanswer twice) or `offline` (no LLM, or the daily allowance is used up).",
      "properties": {
        "text": {
          "type": "string"
        },
        "possession_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "verified",
            "fallback",
            "offline"
          ],
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "text",
        "possession_ids",
        "status"
      ],
      "title": "AnalystReply",
      "type": "object"
    },
    "AnalystRequest": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "history": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ChatTurn"
          },
          "maxItems": 6,
          "type": "array"
        },
        "match_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "style_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "language": {
          "default": "en",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "title": "AnalystRequest",
      "type": "object"
    },
    "BundleManifest": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "public": {
          "type": "boolean"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "contract_version",
        "generated_at",
        "public",
        "files"
      ],
      "title": "BundleManifest",
      "type": "object"
    },
    "ChatTurn": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "type": "string"
        }
      },
      "required": [
        "role",
        "text"
      ],
      "title": "ChatTurn",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "What a narrative asserts, checked against the engine: `better_option` names the best option under the\nstyle (`ref` is its option ID), `chosen_fits_style` says the choice was the best one, `turning_point`\nnames the decision (`ref` is its index) and `style_principle` a factor on the style's card.",
      "properties": {
        "type": {
          "enum": [
            "better_option",
            "chosen_fits_style",
            "turning_point",
            "style_principle"
          ],
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "ref"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClientMessage": {
      "$ref": "#/$defs/Control",
      "title": "ClientMessage"
    },
    "Clock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "clock",
          "default": "clock",
          "type": "string"
        },
        "t_ms": {
          "type": "integer"
        },
        "speed": {
          "type": "number"
        },
        "playing": {
          "type": "boolean"
        }
      },
      "required": [
        "t_ms",
        "speed",
        "playing"
      ],
      "title": "Clock",
      "type": "object"
    },
    "Control": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "control",
          "default": "control",
          "type": "string"
        },
        "action": {
          "enum": [
            "play",
            "pause",
            "seek",
            "speed"
          ],
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action"
      ],
      "title": "Control",
      "type": "object"
    },
    "DangerPoint": {
      "additionalProperties": false,
      "properties": {
        "t_ms": {
          "type": "integer"
        },
        "xt": {
          "type": "number"
        }
      },
      "required": [
        "t_ms",
        "xt"
      ],
      "title": "DangerPoint",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "idx": {
          "type": "integer"
        },
        "frame": {
          "type": "integer"
        },
        "t_ms": {
          "type": "integer"
        },
        "pid": {
          "type": "integer"
        },
        "kind": {
          "enum": [
            "pass",
            "shot",
            "carry"
          ],
          "type": "string"
        },
        "chosen_option_id": {
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "type": "array"
        },
        "is_turning_point": {
          "type": "boolean"
        }
      },
      "required": [
        "idx",
        "frame",
        "t_ms",
        "pid",
        "kind",
        "chosen_option_id",
        "options",
        "is_turning_point"
      ],
      "title": "Decision",
      "type": "object"
    },
    "ErrorMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "error",
          "default": "error",
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "ErrorMessage",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "kind": {
          "enum": [
            "prob",
            "band",
            "metres",
            "xt",
            "count",
            "player",

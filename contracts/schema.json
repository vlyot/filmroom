          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "p_success": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "p_success_band": {
          "enum": [
            "low",
            "medium",
            "high"

          "type": "number"
        }
      },
      "required": [
        "vs_style_id",
        "factor",
        "contribution"
      ],
      "title": "FlipReason",
      "type": "object"
    },
    "Health": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "ok",
          "type": "string"
        },
        "contract_version": {
          "type": "string"
        },
        "source": {
          "enum": [
            "fixtures",
            "engine",
            "database"
          ],
          "type": "string"
        },
        "llm": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "contract_version",
        "source",
        "llm"
      ],
      "title": "Health",
      "type": "object"
    },
    "Latency": {
      "additionalProperties": false,
      "description": "Over the most recent samples (up to 500); null before the first.",
      "properties": {
        "p50_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "p95_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "p50_ms",
        "p95_ms"
      ],
      "title": "Latency",
      "type": "object"
    },
    "LlmMetrics": {
      "additionalProperties": false,
      "description": "Every model call, each step of a tool-calling loop included. The month's figures come from the token\nledger (null without a database); the cost is an estimate at Mistral Small 4 prices, against the monthly\nincluded allowance.",
      "properties": {
        "calls": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "latency": {
          "$ref": "#/$defs/Latency"
        },
        "tokens_today": {
          "type": "integer"
        },
        "daily_token_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "month_calls": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "month_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "month_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowance_usd": {
          "type": "number"
        }
      },
      "required": [
        "calls",
        "errors",
        "latency",
        "tokens_today",
        "daily_token_limit",
        "month_calls",
        "month_tokens",
        "month_cost_usd",
        "allowance_usd"
      ],
      "title": "LlmMetrics",
      "type": "object"
    },
    "Match": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer"
        },
        "has_events": {
          "type": "boolean"
        },
        "teams": {
          "items": {
            "$ref": "#/$defs/Team"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/PlayerRef"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "mode",
        "duration_ms",
        "has_events",
        "teams",
        "players"
      ],
      "title": "Match",
      "type": "object"
    },
    "MatchEnd": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "match_end",
          "default": "match_end",
          "type": "string"
        }
      },
      "title": "MatchEnd",
      "type": "object"
    },
    "MatchSummary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer"
        },
        "has_events": {
          "type": "boolean"
        },
        "teams": {
          "items": {

      "type": "object"
    },
    "MetricsReport": {
      "additionalProperties": false,
      "description": "The API's own counters since start-up, for monitoring alongside Railway's CPU and memory graphs.",
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "source": {
          "enum": [
            "fixtures",
            "engine",
            "database"
          ],
          "type": "string"
        },
        "uptime_s": {
          "type": "integer"
        },
        "requests": {
          "$ref": "#/$defs/RequestMetrics"

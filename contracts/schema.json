        "danger_gain": {
          "type": "number"
        },
        "factors": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "p_success",
              "danger_gain",
              "progression",
              "receiver_space",
              "lane_openness",
              "switch_of_play",
              "counter_press",
              "rest_defence"
            ]
          },
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "target_pid",
        "target_xy",
        "p_success",
        "p_success_band",
        "danger_gain",
        "factors"
      ],
      "title": "Option",
      "type": "object"
    },
    "OutcomeMetrics": {
      "additionalProperties": false,
      "description": "LLM-written outputs since start-up. `fallback`: a template or canned line was served instead, after\nthe verifier rejected the draft twice or the LLM call failed. `rejected`: outputs where the verifier\nrejected at least one draft, retried or not. Rates are null before the first output.",
      "properties": {
        "verified": {
          "type": "integer"
        },
        "fallback": {
          "type": "integer"
        },
        "rejected": {
          "type": "integer"
        },
        "fallback_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "rejection_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "verified",
        "fallback",
        "rejected",
        "fallback_rate",
        "rejection_rate"
      ],
      "title": "OutcomeMetrics",
      "type": "object"
    },
    "OverlayEvent": {

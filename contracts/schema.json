              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "value",
        "kind"
      ],
      "title": "Fact",
      "type": "object"
    },
    "FlipReason": {
      "additionalProperties": false,
      "properties": {
        "vs_style_id": {
          "type": "string"
        },
        "factor": {
          "enum": [
            "p_success",
            "danger_gain",
            "progression",
            "receiver_space",
            "lane_openness",
            "switch_of_play",
            "counter_press",
            "rest_defence"

    "/possessions/{possession_id}/verdict": {
      "get": {
        "summary": "Possession Verdict",
        "description": "The turning-point verdict under a preset (`style`) or custom sliders (all four), with the flip\nreason measured against `vs` (the reference preset by default).",
        "operationId": "possession_verdict_possessions__possession_id__verdict_get",
        "parameters": [
          {
            "name": "possession_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Possession Id"
            }
          },
          {
            "name": "style",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Style"
            }
          },
          {
            "name": "vs",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Vs"
            }
          },
          {
            "name": "risk_tolerance",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 1,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Risk Tolerance"
            }
          },
          {
            "name": "verticality",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 1,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Verticality"
            }
          },
          {
            "name": "press_trigger",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 1,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Press Trigger"
            }
          },
          {
            "name": "line_height",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 1,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Line Height"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Verdict"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/possessions/{possession_id}/narrative": {
      "get": {
        "summary": "Narrative",
        "operationId": "narrative_possessions__possession_id__narrative_get",
        "parameters": [
          {
            "name": "possession_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Possession Id"
            }
          },
          {
            "name": "style",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Style"
            }
          },
          {
            "name": "audience",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "coach",
                "player",
                "fan"
              ],
              "type": "string",
              "default": "coach",
              "title": "Audience"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "en",
              "title": "Language"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Narrative"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Claim": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "better_option",
              "turning_point",
              "player_skill",
              "style_principle"
            ],
            "title": "Type"
          },
          "ref": {
            "type": "string",
            "title": "Ref"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "ref"
        ],
        "title": "Claim"
      },
      "DangerPoint": {
        "properties": {
          "t_ms": {
            "type": "integer",
            "title": "T Ms"
          },
          "xt": {
            "type": "number",
            "title": "Xt"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "t_ms",
          "xt"
        ],
        "title": "DangerPoint"
      },
      "Decision": {
        "properties": {
          "idx": {
            "type": "integer",
            "title": "Idx"
          },
          "frame": {
            "type": "integer",
            "title": "Frame"
          },
          "t_ms": {
            "type": "integer",
            "title": "T Ms"
          },
          "pid": {
            "type": "integer",
            "title": "Pid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pass",
              "shot",
              "carry"
            ],
            "title": "Kind"
          },
          "chosen_option_id": {
            "type": "string",
            "title": "Chosen Option Id"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/Option"
            },
            "type": "array",
            "title": "Options"
          },
          "is_turning_point": {
            "type": "boolean",
            "title": "Is Turning Point"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "idx",
          "frame",
          "t_ms",
          "pid",
          "kind",
          "chosen_option_id",
          "options",
          "is_turning_point"
        ],
        "title": "Decision"
      },
      "Fact": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Value"
          },
          "kind": {
            "type": "string",
            "enum": [
              "prob",
              "band",
              "metres",
              "xt",
              "count",
              "player",
              "text"
            ],
            "title": "Kind"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "value",
          "kind"
        ],
        "title": "Fact"
      },
      "FlipReason": {
        "properties": {
          "vs_style_id": {
            "type": "string",
            "title": "Vs Style Id"
          },
          "factor": {
            "type": "string",
            "enum": [
              "p_success",
              "danger_gain",
              "progression",
              "receiver_space",
              "lane_openness",
              "switch_of_play",
              "counter_press",
              "rest_defence"
            ],
            "title": "Factor"
          },
          "contribution": {
            "type": "number",
            "title": "Contribution"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "vs_style_id",
          "factor",
          "contribution"
        ],
        "title": "FlipReason"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "contract_version": {
            "type": "string",
            "title": "Contract Version"
          },
          "source": {
            "type": "string",
            "enum": [
              "fixtures",
              "engine",
              "database"
            ],
            "title": "Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "contract_version",
          "source"
        ],
        "title": "Health"
      },
      "Match": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          },
          "has_events": {
            "type": "boolean",
            "title": "Has Events"
          },
          "teams": {
            "prefixItems": [
              {
                "$ref": "#/components/schemas/Team"
              },
              {
                "$ref": "#/components/schemas/Team"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Teams"
          },
          "players": {
            "items": {
              "$ref": "#/components/schemas/PlayerRef"
            },
            "type": "array",
            "title": "Players"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "mode",
          "duration_ms",
          "has_events",
          "teams",
          "players"
        ],
        "title": "Match"
      },
      "MatchSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          },
          "has_events": {
            "type": "boolean",
            "title": "Has Events"
          },
          "teams": {
            "prefixItems": [
              {
                "$ref": "#/components/schemas/Team"
              },
              {
                "$ref": "#/components/schemas/Team"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Teams"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "mode",
          "duration_ms",
          "has_events",
          "teams"
        ],
        "title": "MatchSummary"
      },
      "Narrative": {
        "properties": {
          "possession_id": {
            "type": "string",
            "title": "Possession Id"
          },
          "style_id": {
            "type": "string",
            "title": "Style Id"
          },
          "audience": {
            "type": "string",
            "enum": [
              "coach",
              "player",
              "fan"
            ],
            "title": "Audience"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
            "title": "Language"
          },
          "template": {
            "type": "string",
            "title": "Template"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "title": "Claims"
          },
          "status": {
            "type": "string",
            "enum": [
              "template",
              "pending",
              "verified",
              "failed"
            ],
            "title": "Status"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "possession_id",
          "style_id",
          "audience",
          "language",
          "template",
          "claims",
          "status"
        ],
        "title": "Narrative",
        "description": "`template` holds {fact.id} slots; the client fills them from Possession.facts, so no number in a\nnarrative ever comes from the LLM."
      },
      "Option": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pass",
              "shot",
              "carry"
            ],
            "title": "Kind"
          },
          "target_pid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Pid"
          },
          "target_xy": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Xy"
          },
          "p_success": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "P Success"
          },
          "p_success_band": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "P Success Band"
          },
          "danger_gain": {
            "type": "number",
            "title": "Danger Gain"
          },
          "factors": {
            "additionalProperties": {
              "type": "number"
            },
            "propertyNames": {
              "enum": [
                "p_success",
                "danger_gain",
                "progression",
                "receiver_space",
                "lane_openness",
                "switch_of_play",
                "counter_press",
                "rest_defence"
              ]
            },
            "type": "object",
            "title": "Factors"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "target_pid",
          "target_xy",
          "p_success",
          "p_success_band",
          "danger_gain",
          "factors"
        ],
        "title": "Option"
      },
      "PlayerRef": {
        "properties": {
          "pid": {
            "type": "integer",
            "title": "Pid"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "shirt": {
            "type": "integer",
            "title": "Shirt"
          },
          "team": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "title": "Team"
          },
          "role": {
            "type": "string",
            "enum": [
              "GK",
              "OUT"
            ],
            "title": "Role"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pid",
          "key",
          "name",
          "shirt",
          "team",
          "role"
        ],
        "title": "PlayerRef"
      },
      "PositionsChunk": {
        "properties": {
          "possession_id": {
            "type": "string",
            "title": "Possession Id"
          },
          "t0_ms": {
            "type": "integer",
            "title": "T0 Ms"
          },
          "hz": {
            "type": "integer",
            "title": "Hz"
          },
          "pids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Pids"
          },
          "xy": {
            "items": {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            "type": "array",
            "title": "Xy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "possession_id",
          "t0_ms",
          "hz",
          "pids",
          "xy"
        ],
        "title": "PositionsChunk",
        "description": "Samples at a fixed rate. Each row is [x, y] per entity in `pids` order (ball first), flattened."
      },
      "Possession": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "match_id": {
            "type": "string",
            "title": "Match Id"
          },
          "team": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "title": "Team"
          },
          "start_ms": {
            "type": "integer",
            "title": "Start Ms"
          },
          "end_ms": {
            "type": "integer",
            "title": "End Ms"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "shot",
              "goal",
              "lost_tackle",
              "lost_pass",
              "out",
              "stoppage"
            ],
            "title": "Outcome"
          },
          "ended_zone": {
            "type": "string",
            "enum": [
              "own",
              "mid",
              "final"
            ],
            "title": "Ended Zone"
          },
          "flagged": {
            "type": "boolean",

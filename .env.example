# Copy to .env and fill in. .env is gitignored; never paste keys into chat.

# Mistral API key (console.mistral.ai → API Keys). Without it, narratives stay templates and the analyst is offline.
MISTRAL_API_KEY=

# Default chat model: Mistral Small 4 (cheapest with tool calling; draws on the $10 monthly included usage, $0 overage cap)
MISTRAL_CHAT_MODEL=mistral-small-2603

# Where the analyst reaches the engine tools: this API's own MCP endpoint (use the port the API listens on)
MCP_URL=http://127.0.0.1:8000/mcp
# Tokens per UTC day across all LLM calls; past it, narratives stay templates and the analyst goes offline
LLM_DAILY_TOKEN_LIMIT=1500000
# Narrator calls in flight at once (Mistral Small 4 allows 1.67 requests per second)
NARRATOR_CONCURRENCY=2

# SoccER dataset (not in the repo; download from the authors). Folder holding the Match_* directories.
DATA_DIR=
# What the API serves: fixtures (Phase 0 stub, the default), engine (live analysis; needs DATA_DIR) or
# database (engine output seeded into Postgres by scripts/seed_db.py; what Railway runs)
STORE=fixtures
# Postgres with pgvector. When set, the narrative cache and the LLM token ledger live there too.
DATABASE_URL=
# Labelled reference sets (spreadsheets kept outside the repo)
LABELS_PATH=
HOLDOUT_PATH=

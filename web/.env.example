# Copy to .env.local. Without VITE_API_URL the app reads the static bundle in public/bundle (offline mode).
# The FilmRoom API (Railway in production; uvicorn locally). The app falls back to the bundle if it doesn't answer.
VITE_API_URL=http://127.0.0.1:8000
# Base path the app is served under: / locally, /<repo>/ on GitHub Pages
VITE_BASE=/
